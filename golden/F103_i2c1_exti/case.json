{
  "desc": "I2C1 + 两个 GPIO 外部中断(PB0/PB1)。注意:EXIT 的 mode 是透传的,未经 verified",
  "intents": [
    {
      "peripheral": "I2C1",
      "pins": [
        "PB8",
        "PB9"
      ]
    },
    {
      "peripheral": "GPIO",
      "pin": "PB0",
      "mode": "GPXTI0"
    },
    {
      "peripheral": "GPIO",
      "pin": "PB1",
      "mode": "GPXTI1"
    }
  ],
  "expect_commands": [
    "set pin PB0 GPXTI0",
    "set pin PB1 GPXTI1"
  ],
  "expect_ioc_lines": [
    "PB0.Signal=GPXTI0",
    "PB1.Signal=GPXTI1"
  ],
  "expect_init": [
    "MX_GPIO_Init"
  ],
  "source": "EXTI\\EXIT.ioc"
}
